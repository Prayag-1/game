{
  "name": "@kauda/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "demo": "tsc -p tsconfig.json && node dist/cli.js",
    "dev": "tsc -p tsconfig.json && node dist/dev.js",
    "db:generate": "drizzle-kit generate --name init",
    "db:migrate": "tsc -p tsconfig.json && node dist/db/migrateCli.js",
    "db:verify": "tsc -p tsconfig.json && node dist/db/verifyCli.js",
    "distribution": "tsc -p tsconfig.json && node dist/distribution.js"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/ws-transport": "0.18.4",
    "@electric-sql/pglite": "0.5.12",
    "@kauda/rules": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.6",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.10",
    "@electric-sql/pglite-socket": "0.2.15",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "jsdom": "29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
