{
  "name": "@kauda/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "eslint . && tsc -p tsconfig.json --noEmit && vite build && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --dir ../.. exec turbo run build --filter=@kauda/web --filter=@kauda/server && playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.6",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@kauda/rules": "workspace:*",
    "i18next": "25.10.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "15.7.4",
    "react-router": "7.18.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.18",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
